{
  "manifest_version": 3,
  "name": "MV Cut",
  "version": "1.9.3",
  "description": "MV Cut 라이브러리 영상을 X 작성 창에 올려 두고(Send to X), 승인한 초안을 X 예약 게시로 등록하며, 내 X 게시 간격과 서치밴 검사 결과를 알려 주고, TikTok에서 SAVE 버튼으로 영상을 라이브러리에 담습니다.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://mvcut.blackout.kr/*",
    "http://localhost/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://upload.x.com/*",
    "https://www.tiktok.com/*",
    "https://www.youtube.com/*",
    "https://www.instagram.com/*",
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MV Cut X 관리"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://mvcut.blackout.kr/*"
      ],
      "js": [
        "content-mvcut.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content-x.js",
        "content-purge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://www.youtube.com/*",
        "https://www.instagram.com/*"
      ],
      "js": [
        "content-save.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content-save-x.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "content-save-fb.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
